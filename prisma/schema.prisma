// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Volunteer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  passwordHash  String
  isAdmin       Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  duePayments         DuePayment[]
  paymentSubmissions  PaymentSubmission[] @relation("VolunteerSubmissions")
  reviewedSubmissions PaymentSubmission[] @relation("ReviewedSubmissions")
}

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OtpPurpose @default(SIGNUP)
  expiresAt DateTime
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

enum OtpPurpose {
  SIGNUP
  RESET_PASSWORD
}

model DuePayment {
  id          String    @id @default(cuid())
  volunteerId String
  amount      Decimal   @db.Decimal(10, 2)
  note        String
  status      DueStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
}

enum DueStatus {
  PENDING
  PAID
}

model PaymentSubmission {
  id            String           @id @default(cuid())
  volunteerId   String
  amount        Decimal          @db.Decimal(10, 2)
  method        PaymentMethod
  transactionId String?
  status        SubmissionStatus @default(PENDING)
  submittedAt   DateTime         @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?

  volunteer Volunteer  @relation("VolunteerSubmissions", fields: [volunteerId], references: [id], onDelete: Cascade)
  reviewer  Volunteer? @relation("ReviewedSubmissions", fields: [reviewedBy], references: [id])

  @@index([volunteerId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  eventDate   DateTime
  createdAt   DateTime @default(now())

  @@index([eventDate])
}
